# Template for local environment variables. Copy this file to `.env` (already
# gitignored) and fill in real values. Never commit `.env` - it will hold live secrets.
# Loaded by app/config.py via pydantic-settings.

# --- App ---
# Symmetric secret used to sign session JWTs (see app/security.py: create_session_token).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me-to-a-random-64-char-hex-string
# Fernet key used to encrypt Google OAuth access/refresh tokens before storing them in Postgres.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-with-python-cryptography-fernet-generate-key
# "development" | "production" - currently just informational, can gate debug behavior later.
ENVIRONMENT=development

# --- Postgres ---
# SQLAlchemy connection string. Must point at a Postgres instance with the pgvector
# extension available (the docker-compose "postgres" service already has it).
DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator@localhost:5432/orchestrator

# --- Redis ---
# Used for caching (embeddings, intent classifications, conversation context) and rate limiting.
REDIS_URL=redis://localhost:6379/0

# --- OpenAI (or an OpenAI-compatible provider) ---
# API key from platform.openai.com/api-keys. Needs billing enabled for embeddings + chat calls.
OPENAI_API_KEY=sk-...
# Leave commented out to use real OpenAI. Set to point the OpenAI SDK at a different
# OpenAI-compatible endpoint instead - e.g. Gemini (see app/llm_client.py for why this
# is centralized in one place). Note: OPENAI_API_KEY above must then be a Gemini API
# key (from aistudio.google.com/apikey), NOT an OpenAI key.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Chat model used for intent classification and final response synthesis.
OPENAI_CHAT_MODEL=gpt-4o-mini
# For Gemini: use a current Gemini model id - check https://ai.google.dev/gemini-api/docs/models
# for what's currently available (e.g. a "gemini-*-flash" model) rather than assuming
# a specific name here, since Gemini's lineup changes faster than this file gets updated.
# OPENAI_CHAT_MODEL=gemini-<verify-current-flash-model-id>
# Embedding model used to vectorize emails/events/files. app/embeddings/embedder.py
# explicitly requests `dimensions=EMBEDDING_DIMENSIONS` on every call (both OpenAI's
# text-embedding-3-* and Gemini's gemini-embedding-001 support this truncation), so
# leave EMBEDDING_DIMENSIONS at 1536 regardless of provider - do NOT set it to a
# model's native/untruncated size (e.g. Gemini's native 3072), since pgvector's
# ivfflat/hnsw indexes hard-cap at 2000 dimensions and would fail to build entirely.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# For Gemini:
# OPENAI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
# After switching providers, run `alembic upgrade head` to apply
# alembic/versions/0002_reset_embedding_cache_for_provider_switch.py - it doesn't
# resize anything (dimensions stay 1536), it just clears cached embeddings/sync
# status, since a vector from one model isn't comparable to one from another even at
# the same dimension count.

# --- Google OAuth ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match a redirect URI registered on the OAuth client in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Comma-separated OAuth scopes we request consent for: openid+email (so Google returns
# an id_token we can read the user's email from - see app/api/routes_auth.py), plus
# read+send Gmail, full Calendar, full Drive.
GOOGLE_SCOPES=openid,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send,https://www.googleapis.com/auth/gmail.compose,https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/drive

# --- Rate limiting ---
# Per-user cap enforced by the Redis-backed rate limiter (app/cache/rate_limit.py).
QUERIES_PER_USER_PER_HOUR=100

# --- Frontend (optional) ---
# If set, the OAuth callback (app/api/routes_auth.py) redirects here with the session
# token as query params instead of returning raw JSON - point this at the Streamlit
# UI (streamlit_app.py) so login completes without copy-pasting a token by hand.
# Leave unset/commented out to keep the callback returning JSON (for direct API use).
FRONTEND_REDIRECT_URL=http://localhost:8501

# --- Celery ---
# Separate Redis logical DBs (1, 2) from the main cache DB (0) to keep task queue
# traffic isolated from application caching.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# How often celery_beat enqueues the background Gmail/Calendar/Drive sync job.
SYNC_INTERVAL_MINUTES=15
