# Python bytecode/build artifacts
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Secrets - must never be committed (see .env.example for the template that IS committed)
.env

# Test/type-checker caches
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage

# OS/editor cruft
.DS_Store
*.log

# Celery beat's local schedule-tracking file (written next to wherever `celery beat`
# runs - lands in the repo root because docker-compose bind-mounts the repo into the
# celery_beat container).
celerybeat-schedule
